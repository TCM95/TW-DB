    "page": "screen=reqdef",
    "label": "<a class=\"btn\" href=\"#\" style=\"margin-left:5px; transition: all 0.2s;\" onclick=\"try{var ta=document.getElementById('simple_message');if(!ta||!ta.value){UI.ErrorMessage('❗ Brak danych',2000);return false;}if(!this.dataset.copied){var nl=String.fromCharCode(10);var out=[];var bl=ta.value.split('[b]Zaatakowana wioska[/b]');for(var i=1;i<bl.length;i++){var x=bl[i];var c=x.indexOf('[coord]')>-1?x.split('[coord]')[1].split('[/coord]')[0]:'?';var w=x.indexOf('Poziom muru: ')>-1?parseInt(x.split('Poziom muru: ')[1]):'?';var p=x.indexOf('Poparcie: ')>-1?parseInt(x.split('Poparcie: ')[1]):'?';var v='[b]Wioska:[/b] [coord]'+c+'[/coord]'+nl+'[b]Poziom muru:[/b] '+w+nl+'[b]Poparcie:[/b] '+p+nl+nl+'[b]Obrońca:[/b] ';var u=['spear','sword','axe','spy','light','heavy','ram','catapult','snob'];var tb=x.split('[b]Obecne Wojska[/b]')[1]||'';tb=tb.split('[command]attack[/command]')[0];var uc=[];for(var k=0;k<9;k++){var un='[unit]'+u[k]+'[/unit]';uc.push(tb.indexOf(un)>-1?(parseInt(tb.split(un)[1])||0):0);}v+='  '+uc.join('  ')+' '+nl+nl;var ab=x.split('[command]attack[/command]');for(var j=1;j<ab.length;j++){var ax=ab[j];var nm=ax.indexOf('Nazwa ataku: ')>-1?ax.split('Nazwa ataku: ')[1].split(nl)[0].trim():'';var pl=ax.indexOf('Agresor: ')>-1?ax.split('Agresor: ')[1].split(nl)[0].trim():'';var co=ax.indexOf('Pochodzenie: ')>-1?ax.split('Pochodzenie: ')[1].split(nl)[0].trim():'';var ti=ax.indexOf('Czas przybycia: ')>-1?ax.split('Czas przybycia: ')[1].split(nl)[0].trim():'';if(nm){v+='    [command]attack[/command] '+nm+' '+co+' --> Czas przybycia: '+ti+' '+pl+nl;}}out.push(v);}var txt=out.length?out.join(String.fromCharCode(9)+nl):ta.value;var btn=this;navigator.clipboard.writeText(txt).then(function(){UI.SuccessMessage('📋 Skonwertowano!',2500);btn.dataset.copied='true';btn.innerHTML='✅ Otwórz Bazę';btn.style.setProperty('background','linear-gradient(#5cad5c 0%, #2e7a2e 30%, #1f5c1f 80%, #0f2e0f 100%)','important');}).catch(function(){UI.ErrorMessage('⚠️ Błąd',2000);});}else{this.dataset.copied='';this.innerHTML='📋 Eksportuj';this.style.background='';window.open('https://twdatabase.online/attacks','_blank','noopener,noreferrer');}return false;}catch(err){UI.ErrorMessage('❗ Błąd: '+err.message,2500);return false;}\">📋 Eksportuj</a>",
